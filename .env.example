# Copy to .env.local for `npm run dev`; set the same variables in Vercel for deployments.

# Required for the dashboard. Generate one with: openssl rand -hex 24
DASHBOARD_TOKEN=

# Upstash Redis REST credentials. The Vercel Marketplace integration sets KV_REST_API_*
# for you; UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
# Leave empty locally to use the dev server's in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional
# UPSTREAM_URL=https://api.blatent.ai
# UPSTREAM_TIMEOUT_MS=295000
# LOG_BODIES=1
# BODY_LIMIT=16384
# BODY_TTL_DAYS=7
# LOG_LIMIT=2000
# REDIS_PREFIX=sp:
